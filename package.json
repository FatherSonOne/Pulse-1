{
  "name": "pulse",
  "private": true,
  "version": "25.1.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "build": "vite build",
    "build:analyze": "vite build --mode production && npx vite-bundle-visualizer",
    "build:stats": "vite build --mode production && node -e \"const fs=require('fs');const stats=fs.readdirSync('dist/assets').map(f=>({file:f,size:fs.statSync('dist/assets/'+f).size}));console.table(stats.sort((a,b)=>b.size-a.size));\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:run": "npm run android:build && npx cap run android",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_IS_DEV=1 electron .\"",
    "electron:preview": "cross-env ELECTRON_IS_DEV=0 electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "io.qntmpulse.desktop",
    "productName": "Pulse",
    "copyright": "Copyright © 2025 Pulse",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "protocols": [
      {
        "name": "Pulse",
        "schemes": [
          "pulse"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icons/icon-512x512.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512x512.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@anthropic-studio/shared-hub": "file:../shared-hub",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capgo/capacitor-native-biometric": "^8.3.7",
    "@google/genai": "^1.31.0",
    "@hubspot/api-client": "^13.4.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@openai/agents": "^0.3.7",
    "@react-google-maps/api": "^2.20.7",
    "@sentry/react": "^10.35.0",
    "@sentry/tracing": "^7.120.4",
    "@slack/oauth": "^3.0.4",
    "@slack/web-api": "^7.13.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/jszip": "^3.4.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-window": "^1.8.8",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.29.2",
    "fuse.js": "^7.1.0",
    "googleapis": "^171.0.0",
    "hubspot": "^0.0.3",
    "immer": "^11.1.3",
    "isomorphic-dompurify": "^2.35.0",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.8.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "openai": "^6.15.0",
    "pdfjs-dist": "^5.4.149",
    "pg": "^8.18.0",
    "pipedrive": "^30.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-window": "^2.2.7",
    "socket.io-client": "^4.8.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.19.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.11.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.3.0",
    "lighthouse": "^13.0.1",
    "msw": "^2.12.7",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.4"
  }
}
