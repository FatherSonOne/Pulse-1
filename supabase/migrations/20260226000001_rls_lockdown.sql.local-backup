  ON projects FOR ALL USING (owner_id = auth.uid()) WITH CHECK (owner_id = auth.uid());

-- project_templates (created_by UUID)
ALTER TABLE project_templates ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can view own project_templates"
  ON project_templates FOR SELECT USING (created_by = auth.uid() OR created_by IS NULL);
CREATE POLICY "Users can insert own project_templates"
  ON project_templates FOR INSERT WITH CHECK (created_by = auth.uid());
CREATE POLICY "Users can update own project_templates"
  ON project_templates FOR UPDATE USING (created_by = auth.uid());

-- search_documents (user_id UUID)
ALTER TABLE search_documents ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage own search_documents"
  ON search_documents FOR ALL USING (user_id = auth.uid()) WITH CHECK (user_id = auth.uid());

-- search_index (user_id TEXT)
ALTER TABLE search_index ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage own search_index"
  ON search_index FOR ALL USING (user_id = auth.uid()::text) WITH CHECK (user_id = auth.uid()::text);

-- teams (user_id TEXT)
ALTER TABLE teams ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage own teams"
  ON teams FOR ALL USING (user_id = auth.uid()::text) WITH CHECK (user_id = auth.uid()::text);

-- users (user_id UUID) — this is the app users table
ALTER TABLE users ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can view own user record"
  ON users FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can update own user record"
  ON users FOR UPDATE USING (user_id = auth.uid());

-- workspace_settings (workspace_id UUID)
ALTER TABLE workspace_settings ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage own workspace_settings"
  ON workspace_settings FOR ALL USING (public.user_has_workspace_access(workspace_id))
  WITH CHECK (public.user_has_workspace_access(workspace_id));

-- integration_logs — no user column, add one
ALTER TABLE integration_logs ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
ALTER TABLE integration_logs ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage own integration_logs"
  ON integration_logs FOR ALL USING (user_id = auth.uid()) WITH CHECK (user_id = auth.uid());

-- customer_health — no user_id, add one
ALTER TABLE customer_health ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
ALTER TABLE customer_health ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can manage own customer_health"
  ON customer_health FOR ALL USING (user_id = auth.uid()) WITH CHECK (user_id = auth.uid());

-- customer_health_history — no user_id, add one
ALTER TABLE customer_health_history ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
CREATE POLICY "Users can view own customer_health_history"
  ON customer_health_history FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can insert own customer_health_history"
  ON customer_health_history FOR INSERT WITH CHECK (user_id = auth.uid());

-- customer_alerts — no user_id, add one
ALTER TABLE customer_alerts ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
CREATE POLICY "Users can view own customer_alerts"
  ON customer_alerts FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can insert own customer_alerts"
  ON customer_alerts FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can update own customer_alerts"
  ON customer_alerts FOR UPDATE USING (user_id = auth.uid());

-- integration_field_mappings — no user_id, add one
ALTER TABLE integration_field_mappings ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
CREATE POLICY "Users can manage own integration_field_mappings"
  ON integration_field_mappings FOR ALL USING (user_id = auth.uid()) WITH CHECK (user_id = auth.uid());

-- integration_sync_logs — no user_id, add one
ALTER TABLE integration_sync_logs ADD COLUMN IF NOT EXISTS user_id UUID REFERENCES auth.users(id);
CREATE POLICY "Users can view own integration_sync_logs"
  ON integration_sync_logs FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can insert own integration_sync_logs"
  ON integration_sync_logs FOR INSERT WITH CHECK (user_id = auth.uid());


-- ============================================================================
-- SECTION 6: Fix the subtasks workspace_id = auth.uid() pattern
-- (Already correct for Phase 1 — workspace IS user for now)
-- ============================================================================
-- No changes needed — the existing pattern works for single-user isolation.
-- Phase 2 will migrate to proper workspace_members lookup.


-- ============================================================================
-- SECTION 7: Remaining permissive policies to clean up
-- ============================================================================

-- These had USING(true) but also had proper policies alongside them.
-- Drop only the permissive "Allow all" ones, keep the good ones.

-- chat_messages: has proper "Allow viewing/inserting" policies already
DROP POLICY IF EXISTS "Allow inserting messages" ON chat_messages;
-- The existing "Allow viewing messages" checks workspace membership, keep it.

-- ephemeral_workspaces: public read is intentional (discovery), keep SELECT open
-- but restrict mutations
DROP POLICY IF EXISTS "Allow all ephemeral_workspaces" ON ephemeral_workspaces;

-- in_app_messages: public read of active messages is intentional for notifications
-- Keep existing policy


