-- ============================================================================
-- PHASE 1: RLS LOCKDOWN MIGRATION
-- ============================================================================
-- Generated: 2026-02-26
-- Purpose: Replace all permissive "USING (true)" policies with proper
--          user-scoped policies, and enable RLS on tables that lack it.
--
-- STRATEGY:
--   1. Drop all "Allow all" / overly permissive policies
--   2. Replace with auth.uid()-based policies
--   3. Enable RLS on tables that don't have it yet
--   4. Add user_id columns where missing (with backfill notes)
--
-- NOTE: Some tables use TEXT user_id (legacy) vs UUID user_id.
--       We handle both patterns. Conversion to UUID is a Phase 2 task.
--
-- IMPORTANT: Test this in a staging environment first!
-- ============================================================================

BEGIN;

-- ============================================================================
-- HELPER FUNCTION: Check if user is a workspace member
-- (Temporary — Phase 2 will create a proper workspaces/members model)
-- ============================================================================

-- For now, workspace_id often equals the user's own ID (single-user workspace).
-- We'll use a function that can be extended later for team workspaces.
CREATE OR REPLACE FUNCTION public.user_has_workspace_access(ws_id UUID)
RETURNS BOOLEAN
LANGUAGE sql
SECURITY DEFINER
STABLE
AS $$
  -- Phase 1: user IS their own workspace
  -- Phase 2: will check workspace_members table
  SELECT auth.uid() = ws_id
$$;


-- ============================================================================
-- SECTION 1: Tables with USING(true) policies — DROP & REPLACE
-- ============================================================================

-- -------------------------
-- emails (user_id TEXT)
-- -------------------------
DROP POLICY IF EXISTS "Allow all access" ON emails;
CREATE POLICY "Users can view own emails"
  ON emails FOR SELECT USING (user_id = auth.uid()::text);
CREATE POLICY "Users can insert own emails"
  ON emails FOR INSERT WITH CHECK (user_id = auth.uid()::text);
CREATE POLICY "Users can update own emails"
  ON emails FOR UPDATE USING (user_id = auth.uid()::text);
CREATE POLICY "Users can delete own emails"
  ON emails FOR DELETE USING (user_id = auth.uid()::text);

