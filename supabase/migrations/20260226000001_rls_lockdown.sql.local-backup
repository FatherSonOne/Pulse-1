-- VERIFICATION INDEXES (for RLS performance)
-- ============================================================================

CREATE INDEX IF NOT EXISTS idx_emails_user_id ON emails(user_id);
CREATE INDEX IF NOT EXISTS idx_contacts_user_id ON contacts(user_id);
CREATE INDEX IF NOT EXISTS idx_archives_user_id ON archives(user_id);
CREATE INDEX IF NOT EXISTS idx_sms_conversations_user_id ON sms_conversations(user_id);
CREATE INDEX IF NOT EXISTS idx_sms_messages_user_id ON sms_messages(user_id);
CREATE INDEX IF NOT EXISTS idx_voxer_recordings_user_id ON voxer_recordings(user_id);
CREATE INDEX IF NOT EXISTS idx_calendar_events_user_id ON calendar_events(user_id);
CREATE INDEX IF NOT EXISTS idx_tasks_user_id ON tasks(user_id);
CREATE INDEX IF NOT EXISTS idx_messages_user_id ON messages(user_id);
CREATE INDEX IF NOT EXISTS idx_conversations_user_id ON conversations(user_id);
CREATE INDEX IF NOT EXISTS idx_outcomes_user_id ON outcomes(user_id);
CREATE INDEX IF NOT EXISTS idx_relationships_created_by ON relationships(created_by);
CREATE INDEX IF NOT EXISTS idx_quick_vox_messages_sender ON quick_vox_messages(sender_id);
CREATE INDEX IF NOT EXISTS idx_quick_vox_messages_recipient ON quick_vox_messages(recipient_id);
CREATE INDEX IF NOT EXISTS idx_vox_drops_sender ON vox_drops(sender_id);
CREATE INDEX IF NOT EXISTS idx_vox_drops_recipient ON vox_drops(recipient_id);
CREATE INDEX IF NOT EXISTS idx_video_vox_conversations_participants ON video_vox_conversations USING GIN(participant_ids);
CREATE INDEX IF NOT EXISTS idx_video_vox_messages_conversation ON video_vox_messages(conversation_id);
CREATE INDEX IF NOT EXISTS idx_video_vox_messages_sender ON video_vox_messages(sender_id);


