-- ============================================================================
-- SECTION 2: Video Vox tables — member-based access
-- ============================================================================

DROP POLICY IF EXISTS "Allow all on video_vox_conversations" ON video_vox_conversations;
DROP POLICY IF EXISTS "Allow all on video_vox_conversation_members" ON video_vox_conversation_members;
DROP POLICY IF EXISTS "Allow all on video_vox_messages" ON video_vox_messages;
DROP POLICY IF EXISTS "Allow all on video_vox_reactions" ON video_vox_reactions;
DROP POLICY IF EXISTS "Allow all on video_vox_read_receipts" ON video_vox_read_receipts;
DROP POLICY IF EXISTS "Allow all on video_vox_bookmarks" ON video_vox_bookmarks;
DROP POLICY IF EXISTS "Allow all on video_vox_ai_queue" ON video_vox_ai_queue;

-- Conversations: user must be a member
CREATE POLICY "Members can view video_vox_conversations"
  ON video_vox_conversations FOR SELECT
  USING (auth.uid() = ANY(participant_ids) OR created_by = auth.uid());
CREATE POLICY "Users can create video_vox_conversations"
  ON video_vox_conversations FOR INSERT
  WITH CHECK (created_by = auth.uid());
CREATE POLICY "Members can update video_vox_conversations"
  ON video_vox_conversations FOR UPDATE
  USING (auth.uid() = ANY(participant_ids) OR created_by = auth.uid());

-- Conversation members
CREATE POLICY "Members can view video_vox_conversation_members"
  ON video_vox_conversation_members FOR SELECT
  USING (user_id = auth.uid() OR conversation_id IN (
    SELECT id FROM video_vox_conversations WHERE auth.uid() = ANY(participant_ids)
  ));
CREATE POLICY "Users can join video_vox_conversation_members"
  ON video_vox_conversation_members FOR INSERT
  WITH CHECK (user_id = auth.uid());

-- Messages: only if you're in the conversation
CREATE POLICY "Members can view video_vox_messages"
  ON video_vox_messages FOR SELECT
  USING (conversation_id IN (
    SELECT id FROM video_vox_conversations WHERE auth.uid() = ANY(participant_ids)
  ));
CREATE POLICY "Members can send video_vox_messages"
  ON video_vox_messages FOR INSERT
  WITH CHECK (sender_id = auth.uid());
CREATE POLICY "Senders can update video_vox_messages"
  ON video_vox_messages FOR UPDATE
  USING (sender_id = auth.uid());
CREATE POLICY "Senders can delete video_vox_messages"
  ON video_vox_messages FOR DELETE
  USING (sender_id = auth.uid());

-- Reactions
CREATE POLICY "Members can view video_vox_reactions"
  ON video_vox_reactions FOR SELECT
  USING (user_id = auth.uid() OR message_id IN (
    SELECT id FROM video_vox_messages WHERE conversation_id IN (
      SELECT id FROM video_vox_conversations WHERE auth.uid() = ANY(participant_ids)
    )
  ));
CREATE POLICY "Users can add video_vox_reactions"
  ON video_vox_reactions FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can remove video_vox_reactions"
  ON video_vox_reactions FOR DELETE USING (user_id = auth.uid());

-- Read receipts
CREATE POLICY "Users can view own video_vox_read_receipts"
  ON video_vox_read_receipts FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can insert own video_vox_read_receipts"
  ON video_vox_read_receipts FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can update own video_vox_read_receipts"
  ON video_vox_read_receipts FOR UPDATE USING (user_id = auth.uid());

-- Bookmarks
CREATE POLICY "Users can view own video_vox_bookmarks"
  ON video_vox_bookmarks FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can insert own video_vox_bookmarks"
  ON video_vox_bookmarks FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can delete own video_vox_bookmarks"
  ON video_vox_bookmarks FOR DELETE USING (user_id = auth.uid());

-- AI queue
CREATE POLICY "Users can view own video_vox_ai_queue"
  ON video_vox_ai_queue FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can insert own video_vox_ai_queue"
  ON video_vox_ai_queue FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can update own video_vox_ai_queue"
  ON video_vox_ai_queue FOR UPDATE USING (user_id = auth.uid());


